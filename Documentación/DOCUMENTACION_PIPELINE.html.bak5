<div id="core-doc-pane">
  <div class="sub-nav">
    <button class="sub-tab active" onclick="showSubTab('core','cn',this)" data-ls="196" data-le="208">ConceptNode</button>
    <button class="sub-tab" onclick="showSubTab('core','cm',this)" data-ls="209" data-le="435">ConceptMap</button>
